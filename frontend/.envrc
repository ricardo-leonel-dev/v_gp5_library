# Force Node v24.21.0 from the canonical nvm install to win on PATH.
#
# Why: two nvm installs coexist on this developer's machine and the wrong
# one (~/.local/share/nvm/v22.19.0) is on PATH by default. `nvm use` reports
# success but does not reorder PATH for the current shell, so Angular CLI's
# `ng test` fails with "Node.js version v22.19.0 detected" — even though
# .nvmrc pins the correct v24.21.0. Prepending the v24.21.0 binary path
# explicitly bypasses that.
#
# Matches the .nvmrc at the repo root. Idempotent: if v24.21.0 is not
# installed at this path on the developer's machine, the directory simply
# does not exist and PATH is unchanged.

export PATH="$HOME/.nvm/versions/node/v24.21.0/bin:$PATH"