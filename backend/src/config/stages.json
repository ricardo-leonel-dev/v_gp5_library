{
  "dev": {
    "db": {
      "provider": "postgres",
      "connectionEnv": "DATABASE_URL",
      "defaultUrl": "postgres://postgres:postgres@localhost:5432/gp5_library"
    },
    "storage": {
      "provider": "local-fs",
      "dirEnv": "STORAGE_DIR",
      "defaultDir": "./storage"
    },
    "cors": {
      "allowedOriginsEnv": "CORS_ALLOWED_ORIGINS",
      "defaultOrigins": ["http://localhost:4200"]
    }
  },
  "staging": {
    "db": { "provider": "postgres", "connectionEnv": "DATABASE_URL" },
    "storage": { "provider": "local-fs", "dirEnv": "STORAGE_DIR", "defaultDir": "./storage" },
    "cors": { "allowedOriginsEnv": "CORS_ALLOWED_ORIGINS" }
  },
  "main": {
    "db": { "provider": "postgres", "connectionEnv": "DATABASE_URL" },
    "storage": { "provider": "local-fs", "dirEnv": "STORAGE_DIR", "defaultDir": "./storage" },
    "cors": { "allowedOriginsEnv": "CORS_ALLOWED_ORIGINS" }
  }
}